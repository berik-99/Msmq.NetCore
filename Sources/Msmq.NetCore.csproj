<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyName>Msmq.NetCore</AssemblyName>
		<PackageId>Msmq.NetCore</PackageId>
		<Version>1.2.0</Version>
		<Description>MSMQ support for .NET Core and modern .NET on Windows (forked from MSMQ.Messaging). For .NET Framework, use the official System.Messaging assembly.</Description>
		<Authors>Erik Barale, Bill Loytty</Authors>
		<!-- Library code: MIT. Bundled Microsoft API documentation: CC BY 4.0. -->
		<PackageLicenseExpression>MIT AND CC-BY-4.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/berik-99/Msmq.NetCore</PackageProjectUrl>
		<RepositoryUrl>https://github.com/berik-99/Msmq.NetCore</RepositoryUrl>
		<PackageTags>MSMQ, System.Messaging, MSMQ.Messaging</PackageTags>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryType>git</RepositoryType>
		<PackageReleaseNotes>1.2.0: Targets .NET Standard 2.1 and .NET 8 through 11 on Windows; .NET Framework and .NET Core 1.x/2.x are not supported. Migration: ActiveX VT_I1 now returns SByte; replacing XML target types clears cached serializers; applications must explicitly configure BinaryFormatter and reference its compatibility package on .NET 9+. Fixed message buffer corruption, direct ActiveX Write/Send, partial stream reads, pinned buffer leaks, formatter state, and connection cache cleanup. Added external API XML documentation and compatibility notes. See README for migration details.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageOutputPath>../Nuget/$(Configuration)/</PackageOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<IsPackable>true</IsPackable>
	</PropertyGroup>

	<!-- Keep the fallback dependencies usable by .NET Core 3.0 consumers. -->
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.DirectoryServices" Version="4.7.0" />
		<PackageReference Include="System.Security.Permissions" Version="4.7.0" />
		<!-- Patch the drawing dependency pulled in by legacy Windows permission types. -->
		<PackageReference Include="System.Drawing.Common" Version="4.7.3" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="System.DirectoryServices" Version="9.0.3" />
		<PackageReference Include="System.Security.Permissions" Version="9.0.3" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net11.0'">
		<PackageReference Include="System.DirectoryServices" Version="11.0.0" />
		<PackageReference Include="System.Security.Permissions" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\README.md;Assets\icon.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
		<None Remove="Documentation\Msmq.NetCore.xml;Documentation\ThirdPartyNotices.txt;Documentation\LICENSE-API-DOCS.txt" />
		<None Include="Documentation\Msmq.NetCore.xml" CopyToOutputDirectory="PreserveNewest"
		      TargetPath="$(AssemblyName).xml" Pack="true"
		      PackagePath="lib\netstandard2.1\;lib\net8.0\;lib\net9.0\;lib\net10.0\;lib\net11.0\" />
		<None Include="Documentation\ThirdPartyNotices.txt;Documentation\LICENSE-API-DOCS.txt"
		      Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
